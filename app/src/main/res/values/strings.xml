    <string name="settings_anime_preset_undo_summary_defaults" tools:ignore="MissingTranslation">No settings from before the preset are saved: puts the settings the preset changes back to the app defaults</string>
    <string name="settings_anime_preset_undo_confirm" tools:ignore="MissingTranslation">These settings go back to how they were before the anime preset (saved %1$s). Everything else stays as it is.</string>
    <string name="settings_anime_preset_undo_confirm_defaults" tools:ignore="MissingTranslation">No settings from before the preset are saved (it was applied with an older version of the app, or already undone). These settings go back to the app defaults. Everything else stays as it is.</string>
